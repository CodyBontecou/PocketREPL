default_platform(:ios)

APP_ID = "com.bontecou.PocketREPL"
API_KEY_ID = "T7KGDK4Y4V"
API_ISSUER_ID = "6c3b3640-c6bf-40a9-b6e5-57cda2c7776e"
API_KEY_PATH = "/Users/codybontecou/dev/AuthKey_T7KGDK4Y4V.p8"

def connect_api_key
  app_store_connect_api_key(
    key_id: API_KEY_ID,
    issuer_id: API_ISSUER_ID,
    key_filepath: API_KEY_PATH,
    in_house: false
  )
end

platform :ios do
  desc "Show current app info on App Store Connect"
  lane :info do
    connect_api_key
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.message("App: #{app.name} (#{app.bundle_id})")

    edit = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    if edit
      UI.message("Edit version: #{edit.version_string} — state: #{edit.app_store_state}")
      localizations = edit.get_app_store_version_localizations
      localizations.each do |loc|
        UI.message("  Locale: #{loc.locale}")
        sets = loc.get_app_screenshot_sets
        sets.each do |set|
          UI.message("    #{set.screenshot_display_type}: #{set.app_screenshots.count} screenshots")
        end
      end
    else
      UI.message("No edit version found")
    end

    live = app.get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    if live
      UI.message("Live version: #{live.version_string} — state: #{live.app_store_state}")
    else
      UI.message("No live version found")
    end
  end

  desc "Upload metadata only"
  lane :upload_metadata do
    connect_api_key
    deliver(
      app_identifier: APP_ID,
      app_version: "1.0",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      run_precheck_before_submit: false,
      force: true,
      platform: "ios",
      team_id: "67KC823C9A",
      dev_portal_team_id: "67KC823C9A",
      app_review_information: {}
    )
  end

  desc "Upload screenshots only"
  lane :upload_screenshots do
    connect_api_key
    deliver(
      app_identifier: APP_ID,
      app_version: "1.0",
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
      platform: "ios"
    )
  end

  desc "Upload metadata + screenshots"
  lane :upload_all do
    connect_api_key
    deliver(
      app_identifier: APP_ID,
      app_version: "1.0",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
      platform: "ios"
    )
  end

  desc "Submit for review (uploads metadata + screenshots first)"
  lane :submit do
    connect_api_key
    deliver(
      app_identifier: APP_ID,
      app_version: "1.0",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      platform: "ios",
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
  desc "Create the Pro IAP on App Store Connect"
  lane :create_iap do
    api_key = connect_api_key
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App not found: #{APP_ID}") unless app

    iap = Spaceship::ConnectAPI::InAppPurchase.create(
      app_id: app.id,
      attributes: {
        referenceName: "PocketREPL Pro",
        productId: "com.bontecou.PocketREPL.pro",
        inAppPurchaseType: "NON_CONSUMABLE",
        familySharable: true
      }
    )
    UI.success("Created IAP: #{iap.product_id} (id: #{iap.id})")

    # Add English localization
    iap.create_iap_localization(
      attributes: {
        locale: "en-US",
        name: "PocketREPL Pro",
        description: "Unlock unlimited AI conversations, local model support, and full JavaScript runtime access."
      }
    )
    UI.success("Added en-US localization")

    # Set price (tier 3 = $2.99)
    iap.create_price_schedule(
      attributes: {
        manualPrices: false
      },
      relationships: {
        baseTerritory: {
          data: { type: "territories", id: "USA" }
        },
        priceTier: {
          data: { type: "inapppurchasePriceTiers", id: "3" }
        }
      }
    )
    UI.success("Set price tier 3 ($2.99)")
  end

  desc "Create app on App Store Connect"
  lane :create_app do
    connect_api_key
    produce(
      app_identifier: APP_ID,
      app_name: "PocketREPL",
      language: "English",
      app_version: "1.0",
      sku: "pocketrepl-ios-2026",
      team_id: "67KC823C9A",
      platform: "ios"
    )
  end
end
