<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld carácter</string>
			<key>other</key>
			<string>%lld caracteres</string>
		</dict>
	</dict>
	<key>⚠️ Retry limit reached after %lld consecutive failures on the same error. Please review and provide guidance.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>⚠️ Límite de reintentos alcanzado después de %lld fallo consecutivo con el mismo error. Por favor, revisa y proporciona orientación.</string>
			<key>other</key>
			<string>⚠️ Límite de reintentos alcanzado después de %lld fallos consecutivos con el mismo error. Por favor, revisa y proporciona orientación.</string>
		</dict>
	</dict>
</dict>
</plist>
